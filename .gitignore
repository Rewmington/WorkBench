# 库文件本来都在 %APPDATA% 下，这条是防御性的：临时导出的副本别顺手 commit
*.db
*.db-wal
*.db-shm

# Android 发布签名（本机保留；CI 从 GitHub Secrets 还原）
mobile/.signing/
mobile/android/key.properties

# 编辑器 / 代理工具
.qoder/
.idea/
*.iml
.claude/
# 杂项
*.log
