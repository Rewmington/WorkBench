<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 的备份/迁移规则，与 manifest 里 `allowBackup="false"` 是同一件事的两半：
  低版本看 `fullBackupContent`，31+ 看这一份，只给一个会留下另一条通道。

  为什么要关：手机本地的 `anvil.db` 是**明文**的（`sqflite`，加密只在出门的
  `device-*.enc` 信封那一层 —— issue #1 的 P0-4）。Auto Backup 默认会把 app 私有目录
  整个打进云端备份，于是待办、课表、药箱数据会以明文离开设备。
  真正的备份走坚果云那份加密快照，不需要系统备份再存一份明文。

  `root` 覆盖整个文件树（含 files/ 与 no_backup/），列出的其余域是显式表达意图，
  免得日后有人加了新的存储位置又想当然地以为它没被备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
