{
  "name": "anvil",
  "private": true,
  "version": "0.1.7",
  "description": "Anvil — local-first personal workbench (Tauri + Vue + Rust)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:style": "node tools/lint-style.mjs && node tools/token-check.mjs",
    "contract": "node tools/contract-check.mjs",
    "version:check": "node tools/version-check.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "lucide-vue-next": "1.0.0",
    "marked": "18.1.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
